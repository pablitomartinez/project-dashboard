# Copy to .env.local and fill in real values. Never commit .env.local.
# Server-only variables: do not add the NEXT_PUBLIC_ prefix.

# Supabase project URL (Project Settings > API), e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
SUPABASE_SECRET_KEY=
